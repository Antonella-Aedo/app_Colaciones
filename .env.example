# Config de Firebase (Firebase Console > Project Settings > Your apps > Web app > SDK setup)
# Pegar como JSON string (una sola línea). Ejemplo:
# VITE_FIREBASE_CONFIG={"apiKey":"AIza...","authDomain":"app-colaciones-506203.firebaseapp.com","projectId":"app-colaciones-506203","storageBucket":"app-colaciones-506203.appspot.com","messagingSenderId":"123","appId":"1:123:web:abc"}
VITE_FIREBASE_CONFIG=

# App Check (opcional) — site key de reCAPTCHA v3 para proteger Firestore.
# Obtener en: Firebase Console > Project Settings > App Check > Register app
# Dejar vacio para deshabilitar App Check (en dev se omite silenciosamente).
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
