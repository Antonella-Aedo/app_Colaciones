rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // REGLAS DE FIRESTORE — app_Colaciones
    // =====================================================================
    // Colecciones: productos, colaciones, clientes, pedidos, usuariosPermitidos
    //
    // Tres modos de operación (SOLO UNO activo a la vez):
    //
    //   1. MODO DESARROLLO (totalmente abierto)  → ver bloque comentado abajo
    //   2. MODO TRANSICIÓN MVP (lectura sin auth, escritura con auth)
    //      → ver bloque comentado abajo
    //   3. MODO SEGURO (auth obligatoria + validación de campos)  → ACTIVO
    //
    // Para cambiar de modo: comenta/descomenta el bloque correspondiente.
    // El modo seguro (3) es el que debe estar activo en cualquier entorno
    // que no sea desarrollo local.
    // =====================================================================


    // =====================================================================
    // MODO 1 — DESARROLLO (totalmente abierto)
    // =====================================================================
    // SOLO DESARROLLO — NO USAR EN PRODUCCION
    // Estas reglas permiten acceso total sin autenticación. Cualquiera con
    // la configuración de Firebase puede leer, crear, modificar o eliminar
    // cualquier documento. Usar únicamente en entorno local de desarrollo.
    //
    // Para activar: descomenta este bloque Y comenta el bloque del MODO 3.
    //
    // match /{document=**} {
    //   allow read, write: if true;
    // }
    // =====================================================================


    // =====================================================================
    // MODO 2 — TRANSICIÓN MVP (lectura pública, escritura con auth)
    // =====================================================================
    // SOLO DESARROLLO / STAGING — NO USAR EN PRODUCCION
    // Permite lectura sin autenticación (para que la app funcione durante
    // la transición del MVP sin auth) pero exige autenticación para todas
    // las escrituras, con validación de campos.
    //
    // Para activar: descomenta este bloque Y comenta el bloque del MODO 3.
    //
    // match /productos/{docId} {
    //   allow read: if true;
    //   allow create, update, delete: if isSignedIn() && productoValido();
    // }
    // match /colaciones/{docId} {
    //   allow read: if true;
    //   allow create, update, delete: if isSignedIn() && colacionValida();
    // }
    // match /pedidos/{docId} {
    //   allow read: if true;
    //   allow create, update, delete: if isSignedIn() && pedidoValido();
    // }
    // =====================================================================


    // =====================================================================
    // MODO 3 — SEGURO (auth obligatoria + validación) — ACTIVO
    // =====================================================================
    // Este es el modo que debe estar activo en staging y producción.
    // Requiere autenticación para todas las operaciones (lectura y
    // escritura) y valida tipos de campos, campos obligatorios y
    // allowlists de campos en cada escritura.
    // =====================================================================

    // ---------------------------------------------------------------------
    // Funciones auxiliares — autenticación
    // ---------------------------------------------------------------------

    // Verifica que el usuario esté autenticado.
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica que el usuario sea administrador autorizado.
    // Requiere: (1) sesión autenticada Y (2) exista un documento en
    // /usuariosPermitidos con ID = email del usuario en minúsculas.
    // Firestore Rules expone el email del usuario autenticado con Google
    // en request.auth.token.email; .lowercase() normaliza para coincidir
    // con los doc IDs (que se guardan en minúsculas).
    function isAuthedAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuariosPermitidos/$(request.auth.token.email.lowercase()));
    }

    // ---------------------------------------------------------------------
    // Funciones auxiliares — tipos primitivos
    // ---------------------------------------------------------------------

    function isString(v)    { return v is string; }
    function isNumber(v)    { return v is number; }
    function isBool(v)      { return v is bool; }
    function isList(v)      { return v is list; }
    function nonEmptyStr(v) { return isString(v) && v.size() > 0; }
    function isStrOrNull(v) { return isString(v) || v == null; }

    // Verifica que el mapa `data` contenga exactamente los campos listados
    // en `allowed` (allowlist — rechaza campos arbitrarios no definidos en
    // el esquema).
    function hasOnlyFields(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    // ---------------------------------------------------------------------
    // Validación — productos
    // ---------------------------------------------------------------------
    // Esquema:
    //   nombre:      string, no vacío
    //   descripcion: string
    //   precio:      number, >= 0
    //   categoria:   string
    //   disponible:  boolean
    // Allowlist: [nombre, descripcion, precio, categoria, disponible]

    function productoValido() {
      let data = request.resource.data;
      return hasOnlyFields(data, ['nombre', 'descripcion', 'precio', 'categoria', 'disponible'])
        && nonEmptyStr(data.nombre)
        && isString(data.descripcion)
        && isNumber(data.precio)
        && data.precio >= 0
        && isString(data.categoria)
        && isBool(data.disponible);
    }

    // ---------------------------------------------------------------------
    // Validación — colaciones
    // ---------------------------------------------------------------------
    // Esquema:
    //   nombre:    string, no vacío
    //   fecha:     string (ISO yyyy-MM-dd)
    //   activa:    boolean
    //   creadoPor: string
    //   items:     list (array de ColacionItem)
    // Allowlist: [nombre, fecha, activa, creadoPor, items]

    function colacionValida() {
      let data = request.resource.data;
      // TODO post-MVP: exigir que data.creadoPor == request.auth.uid
      //   (los datos existentes tienen texto libre; alinear primero la app
      //   para que escriba el uid del usuario autenticado).
      return hasOnlyFields(data, ['nombre', 'fecha', 'activa', 'creadoPor', 'items'])
        && nonEmptyStr(data.nombre)
        && isString(data.fecha)
        && isBool(data.activa)
        && isString(data.creadoPor)
        && isList(data.items);
    }

    // ---------------------------------------------------------------------
    // Validación — clientes
    // ---------------------------------------------------------------------
    // Esquema:
    //   direccion: string, no vacío
    //   contacto:  string, no vacío
    //   nombre:    string | null (opcional)
    // Allowlist: [direccion, contacto, nombre]

    function clienteValido() {
      let data = request.resource.data;
      return hasOnlyFields(data, ['direccion', 'contacto', 'nombre'])
        && nonEmptyStr(data.direccion)
        && nonEmptyStr(data.contacto)
        && (data.nombre == null || isString(data.nombre));
    }

    // ---------------------------------------------------------------------
    // Validación — pedidos
    // ---------------------------------------------------------------------
    // Esquema (modelo nuevo de Pedido):
    //   fecha:                 string (ISO yyyy-MM-dd)
    //   clienteId:             string, no vacío
    //   clienteNombre:         string | null (opcional, puede ser null)
    //   clienteDireccion:      string, no vacío
    //   clienteContacto:       string, no vacío
    //   registradoPor:         string
    //   colacionId:            string | null (opcional)
    //   items:                 list (array de PedidoItem)
    //   total:                 number, >= 0
    //   estado:                string, uno de:
    //                            creado | pagado | programado |
    //                            entregando | entregado | cancelado
    //   tipoEntrega:           string, uno de: delivery | retiro
    //   deliveryCost:          number, >= 0
    //   metodoPago:            string, uno de: efectivo | tarjeta | transferencia
    //   estadoPago:            string, uno de: pendiente | pagado
    //   estadoActualizadoPor:  string (opcional en create)
    //   estadoActualizadoEn:   string (opcional en create)
    //   historialEstados:      list (opcional en create)
    // Allowlist (todos los campos):
    //   [fecha, clienteId, clienteNombre, clienteDireccion, clienteContacto,
    //    registradoPor, colacionId, items, total, estado, tipoEntrega,
    //    deliveryCost, metodoPago, estadoPago, estadoActualizadoPor,
    //    estadoActualizadoEn, historialEstados]

    function isValidEstado(v) {
      return isString(v)
        && (v == 'creado' || v == 'pagado' || v == 'programado'
          || v == 'entregando' || v == 'entregado' || v == 'cancelado');
    }

    function isValidTipoEntrega(v) {
      return isString(v) && (v == 'delivery' || v == 'retiro');
    }

    function isValidMetodoPago(v) {
      return isString(v)
        && (v == 'efectivo' || v == 'tarjeta' || v == 'transferencia');
    }

    function isValidEstadoPago(v) {
      return isString(v) && (v == 'pendiente' || v == 'pagado');
    }

    function pedidoValido() {
      let data = request.resource.data;
      // TODO post-MVP: exigir que data.registradoPor == request.auth.uid
      //   (los datos existentes tienen texto libre; alinear primero la app
      //   para que escriba el uid del usuario autenticado).
      // Campos de auditoría (estadoActualizadoPor, estadoActualizadoEn,
      // historialEstados) son opcionales en create: pueden estar presentes
      // o no. Por eso se incluyen en el allowlist pero se validan como
      // opcionales (isStrOrNull / isListOrNull).
      return hasOnlyFields(data, [
          'fecha', 'clienteId', 'clienteNombre', 'clienteDireccion',
          'clienteContacto', 'registradoPor', 'colacionId', 'items', 'total',
          'estado', 'tipoEntrega', 'deliveryCost', 'metodoPago', 'estadoPago',
          'estadoActualizadoPor', 'estadoActualizadoEn', 'historialEstados'
        ])
        && isString(data.fecha)
        && nonEmptyStr(data.clienteId)
        && isStrOrNull(data.clienteNombre)
        && nonEmptyStr(data.clienteDireccion)
        && nonEmptyStr(data.clienteContacto)
        && isString(data.registradoPor)
        && isStrOrNull(data.colacionId)
        && isList(data.items)
        && isNumber(data.total)
        && data.total >= 0
        && isValidEstado(data.estado)
        && isValidTipoEntrega(data.tipoEntrega)
        && isNumber(data.deliveryCost)
        && data.deliveryCost >= 0
        && isValidMetodoPago(data.metodoPago)
        && isValidEstadoPago(data.estadoPago)
        && isStrOrNull(data.estadoActualizadoPor)
        && isStrOrNull(data.estadoActualizadoEn)
        && (data.historialEstados == null || isList(data.historialEstados));
    }

    // ---------------------------------------------------------------------
    // Reglas de colección — productos
    // ---------------------------------------------------------------------
    // Lectura y escritura requieren auth (modo seguro).
    // create/update validan campos con productoValido().
    // delete: requiere auth. No se puede verificar referencias inversas desde
    //   colaciones/pedidos dentro de las reglas (Firestore no permite
    //   consultar otras colecciones en reglas). La protección contra
    //   eliminar productos referenciados debe hacerse a nivel de aplicación
    //   (verificar que no existan items con ese productoId antes de borrar).
    //   Aquí al menos garantizamos que solo un usuario autenticado puede
    //   eliminar.

    match /productos/{productoId} {
      allow read:   if isAuthedAdmin();
      allow create: if isAuthedAdmin() && productoValido();
      allow update: if isAuthedAdmin() && productoValido();
      allow delete: if isAuthedAdmin();
    }

    // ---------------------------------------------------------------------
    // Reglas de colección — colaciones
    // ---------------------------------------------------------------------

    match /colaciones/{colacionId} {
      allow read:   if isAuthedAdmin();
      allow create: if isAuthedAdmin() && colacionValida();
      allow update: if isAuthedAdmin() && colacionValida();
      allow delete: if isAuthedAdmin();
    }

    // ---------------------------------------------------------------------
    // Reglas de colección — clientes
    // ---------------------------------------------------------------------
    // CRUD igual a productos: read/write con isAuthedAdmin + validación.

    match /clientes/{clienteId} {
      allow read:   if isAuthedAdmin();
      allow create: if isAuthedAdmin() && clienteValido();
      allow update: if isAuthedAdmin() && clienteValido();
      allow delete: if isAuthedAdmin();
    }

    // ---------------------------------------------------------------------
    // Reglas de colección — pedidos
    // ---------------------------------------------------------------------
    // Req 5: una vez que un pedido está 'entregado' no puede editarse ni
    // eliminarse (bloqueo a nivel de reglas; la app también debe ocultar
    // las acciones de edición/borrado en ese estado).

    match /pedidos/{pedidoId} {
      allow read:   if isAuthedAdmin();
      allow create: if isAuthedAdmin() && pedidoValido();
      allow update: if isAuthedAdmin() && pedidoValido()
        && resource.data.estado != 'entregado';  // no editar si entregado
      allow delete: if isAuthedAdmin()
        && resource.data.estado != 'entregado';  // no eliminar si entregado
    }

    // ---------------------------------------------------------------------
    // Reglas de colección — usuariosPermitidos
    // ---------------------------------------------------------------------
    // Lista de emails autorizados para acceder a la app.
    // Cada documento tiene como ID el email en minúsculas.
    // Lectura: cualquier usuario autenticado puede leer. Esto es necesario
    //   porque isAuthedAdmin() usa exists() sobre esta colección, y
    //   Firestore evalúa los permisos de lectura del documento objetivo
    //   dentro de exists(). Si la lectura exigiera isAuthedAdmin() se
    //   crearía una dependencia circular (exists() siempre devolvería
    //   false) y nadie podría autorizarse. Los datos son solo emails, no
    //   información sensible.
    // Escritura: requiere isAuthedAdmin() (solo admins ya autorizados
    //   pueden añadir/quitar emails). El primer admin debe sembrarse
    //   manualmente desde la consola de Firebase.

    match /usuariosPermitidos/{emailId} {
      allow read:   if isSignedIn();
      allow write:  if isAuthedAdmin();
    }

    // ---------------------------------------------------------------------
    // Bloqueo por defecto — niega todo lo no contemplado arriba.
    // ---------------------------------------------------------------------
    // Cualquier colección no listada explícitamente queda inaccesible.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
